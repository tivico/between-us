{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "between-us",
  "account_id": "12f68924cf47d343d2067d92c70c7bea",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "between-us",
    "database_id": "c7694cfa-1d1b-47e9-9379-6cd08812947a",
    "migrations_dir": "cloudflare/migrations"
  }]
}
